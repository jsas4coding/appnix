{
  "name": "appnix",
  "version": "1.0.1",
  "description": "Convert websites to Linux desktop apps (.deb)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "tsc && tsc-alias && node dist/scripts/setup.js && rimraf dist",
    "build": "tsc && tsc-alias && node dist/builder/build.js && rimraf dist",
    "clean": "rimraf dist",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test": "vitest run --watch=false tests/unit",
    "test:coverage": "vitest run --watch=false tests/unit --coverage",
    "test:e2e": "vitest run --watch=false tests/e2e",
    "test:watch": "vitest watch tests/unit"
  },
  "dependencies": {
    "electron-builder": "^26.8.1",
    "handlebars": "^4.7.8",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.1",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
